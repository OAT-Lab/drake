Drake benchmark instrumentation: count the iterations of libccd GJK loops
(intersection test and distance) in a thread-local counter, so a benchmark
can compare FCL and Coal iteration counts. Not intended for upstream.

--- include/fcl/narrowphase/detail/convexity_based_algorithm/gjk_libccd-inl.h
+++ include/fcl/narrowphase/detail/convexity_based_algorithm/gjk_libccd-inl.h
@@ -189,6 +189,12 @@ struct ccd_triangle_t : public ccd_obj_t
 namespace libccd_extension
 {
 
+// Drake benchmark instrumentation: GJK loop iterations, reset by the caller.
+inline unsigned long& gjk_iteration_count() {
+  thread_local unsigned long count = 0;
+  return count;
+}
+
 // These two functions contain the only "valid" invocations of
 // ccdVec3PointTriDist2(). Any other invocations should be considered a defect.
 // We can remove these safety layers if/when the issue noted below gets
@@ -1711,6 +1717,7 @@ static int __ccdGJK(const void *obj1, const void *obj2,
 
   // start iterations
   for (iterations = 0UL; iterations < ccd->max_iterations; ++iterations) {
+    ++gjk_iteration_count();
     // obtain support point
     __ccdSupport(obj1, obj2, &dir, ccd, &last);
 
@@ -2137,6 +2144,7 @@ static inline ccd_real_t _ccdDist(const void *obj1, const void *obj2,
 
   for (unsigned long iterations = 0UL; iterations < ccd->max_iterations;
        ++iterations) {
+    ++gjk_iteration_count();
     ccd_vec3_t closest_p; // The point on the simplex that is closest to the
                           // origin.
     ccd_real_t dist;